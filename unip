    ║ SHA256: {hashes['SHA256']}
    ║ SHA512: {hashes['SHA512']}
    ╚══════════════════════════════════════════════════════════════════════╝
    """
        print(output)
        if output_file:
            save_output(output_file, output)
    
    elif command == '-info':
        if len(args) < 2:
            print(color_text('[-] Usage: unip -info <ip>', 'red'))
            sys.exit(1)
        
        ip = args[1]
        
        print(color_text(f'\n[*] Gathering all information for {ip}', 'yellow'))
        print()
        
        location = get_ip_location(ip)
        ports = scan_ports(ip)
        rdns = reverse_dns(ip)
        network = get_ip_network_info(ip)
        
        output = f"""
    ╔══════════════════════════════════════════════════════════════════════╗
    ║                    COMPLETE IP INFORMATION                           ║
    ╠══════════════════════════════════════════════════════════════════════╣
    ║ IP: {ip}
    ║ Location: {location.get('city', 'N/A')}, {location.get('region', 'N/A')}, {location.get('country', 'N/A')}
    ║ Coordinates: {location.get('lat', 0)}, {location.get('lon', 0)}
    ║ ISP: {location.get('isp', 'N/A')}
    ║ Reverse DNS: {rdns}
    ║ Network: {network['network'] if network else 'N/A'}
    ║ Open Ports: {', '.join(map(str, ports)) if ports else 'None found'}
    ╚══════════════════════════════════════════════════════════════════════╝
    """
        print(output)
        
        if output_file:
            save_output(output_file, output)
    
    elif command == '-myip':
        ip = get_public_ip()
        if ip:
            print(color_text(f'\n[+] Your public IP: {ip}', 'green'))
        else:
            print(color_text('\n[-] Could not determine your IP', 'red'))
    
    elif command == '-ssh':
        if len(args) < 2:
            print(color_text('[-] Usage: unip -ssh <ip> -u <username>', 'red'))
            sys.exit(1)
        
        ip = args[1]
        username = None
        port = 22
        
        if '-u' in args:
            u_index = args.index('-u')
            if u_index + 1 < len(args):
                username = args[u_index + 1]
        
        if '-p' in args:
            p_index = args.index('-p')
            if p_index + 1 < len(args):
                port = int(args[p_index + 1])
        
        if not username:
            username = input(color_text('[?] Username: ', 'yellow'))
        
        password = getpass.getpass(color_text('[?] Password: ', 'yellow'))
        ssh_connect(ip, username, password=password, port=port)
    
    elif command == '-sshphone':
        if len(args) < 2:
            print(color_text('[-] Usage: unip -sshphone <ip> -u <username>', 'red'))
            sys.exit(1)
        
        ip = args[1]
        username = None
        
        if '-u' in args:
            u_index = args.index('-u')
            if u_index + 1 < len(args):
                username = args[u_index + 1]
        
        if not username:
            username = input(color_text('[?] Termux username: ', 'yellow'))
        
        print(color_text('\n[*] Connecting to your phone via SSH (port 8022)', 'yellow'))
        ssh_connect(ip, username, port=8022)
    
    elif command == '-sshs':
        print(color_text('\n[*] Starting SSH server...', 'yellow'))
        subprocess.run(['sudo', 'systemctl', 'start', 'ssh'])
        print(color_text('[+] SSH server started', 'green'))
    
    elif command == '-sshsstop':
        print(color_text('\n[*] Stopping SSH server...', 'yellow'))
        subprocess.run(['sudo', 'systemctl', 'stop', 'ssh'])
        print(color_text('[+] SSH server stopped', 'green'))
    
    elif command == '-sshstatus':
        result = subprocess.run(['systemctl', 'is-active', 'ssh'], capture_output=True, text=True)
        if result.stdout.strip() == 'active':
            print(color_text('\n[+] SSH server is RUNNING', 'green'))
        else:
            print(color_text('\n[-] SSH server is STOPPED', 'red'))
    
    elif command == '-sshkeygen':
        print(color_text('\n[*] Generating SSH key pair...', 'yellow'))
        key_path = os.path.expanduser("~/.ssh/id_rsa")
        subprocess.run(['ssh-keygen', '-t', 'rsa', '-b', '4096', '-f', key_path])
        print(color_text(f'[+] Key generated: {key_path}', 'green'))
    
    else:
        print(color_text(f'\n[-] Unknown command: {command}', 'red'))
        print(color_text('[*] Type unip -h for help', 'yellow'))

